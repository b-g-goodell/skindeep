#!/bin/sh
# skinned: run a terminal CLI inside a claude-skins window.
# The caller's stderr stays on fd 3 for the app's own messages.
# Electron's stderr goes to a per-launch log.

usage() {
  echo "usage: skinned [--skin NAME|PATH] [--statusline=always|chain-only] [--no-viz] [--mute] [--unsafe-no-sandbox] -- CMD [ARGS...]" >&2
  exit 125
}

self=$(readlink -f "$0") || exit 125
repo=$(dirname "$(dirname "$self")")
electron="$repo/node_modules/electron/dist/electron"
if [ ! -x "$electron" ]; then
  echo "skinned: $electron missing, run $repo/install.sh" >&2
  exit 125
fi

# Check the app's own options here, so a typo fails before any window.
found=
unsafe=
[ "${SKINNED_UNSAFE_NO_SANDBOX:-}" = 1 ] && unsafe=1
for a in "$@"; do
  case "$a" in
    --) found=1; break ;;
    --unsafe-no-sandbox) unsafe=1 ;;
    --skin|--skin=*|--statusline=always|--statusline=chain-only|--no-viz|--mute) ;;
    -*) echo "skinned: unknown option $a" >&2; usage ;;
  esac
done
[ -n "$found" ] || usage

# Chromium's sandbox confines every page the app renders (decision
# 0001). Where it cannot start, refuse rather than run without it,
# unless the caller asked for that by name.
. "$repo/scripts/sandbox.sh"
if [ -z "$unsafe" ] && ! sandbox_starts "$electron"; then
  echo "skinned: Chromium's sandbox does not start for $electron" >&2
  echo "skinned: run $repo/install.sh once: it installs, with sudo, what the sandbox needs on this system" >&2
  echo "skinned: --unsafe-no-sandbox or SKINNED_UNSAFE_NO_SANDBOX=1 runs without it, and a bug in any page it renders then runs with all your rights" >&2
  exit 125
fi

logdir="${XDG_STATE_HOME:-$HOME/.local/state}/claude-skins"
mkdir -p "$logdir" || exit 125
log="$logdir/$(date +%Y%m%d-%H%M%S)-$$.log"

# Chromium writes into its user data dir while it shuts down, so the
# runtime dir is removed here, after Electron has exited.
if [ -n "$XDG_RUNTIME_DIR" ]; then
  rundir="$XDG_RUNTIME_DIR/claude-skins/$$"
else
  rundir="${XDG_STATE_HOME:-$HOME/.local/state}/claude-skins-run/$$"
fi
export SKINNED_RUNTIME_DIR="$rundir"

# Terminal signals reach Electron directly (same process group). The
# trap only keeps this shell alive to clean up after it.
trap : INT TERM HUP
exec 3>&2
"$electron" ${unsafe:+--no-sandbox} "$repo" "$@" 2>>"$log"
code=$?
exec 3>&-
rm -rf "$rundir"
exit $code
