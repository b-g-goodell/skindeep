   "format": "int",
   "rect": {
    "right": 22,
    "top": 324,
    "width": 244,
    "height": 21
   },
   "class": "row"
  },
  {
   "id": "pl-7",
   "type": "readout",
   "bind": "tools.WebFetch",
   "label": "web fetch",
   "format": "int",
   "rect": {
    "right": 22,
    "top": 347,
    "width": 244,
    "height": 21
   },
   "class": "row"
  },
  {
   "id": "pl-8",
   "type": "readout",
   "bind": "tools.Agent",
   "label": "agent",
   "format": "int",
   "rect": {
    "right": 22,
    "top": 370,
    "width": 244,
    "height": 21
   },
   "class": "row"
  },
  {
   "id": "pl-9",
   "type": "readout",
