{
  "name": "coffee",
  "version": "2.0.0",
  "author": "claude-skins",
  "license": "project-original",
  "description": "A bohemian basement cafe: a chalkboard of readouts under string lights that flare at each tool call, handbills on a corkboard, a lava lamp that bubbles while the agent works, a turntable whose record rings the context, a tube amp whose VU meter reads tokens per second, a French press and jars of cold brew for the cache and limits, mismatched mugs for the subagents, and the quiet sounds of the room.",
  "window": { "width": 1240, "height": 820, "minWidth": 1100, "minHeight": 680 },
  "menu": { "rect": { "left": 30, "top": 32, "width": 36, "height": 28 }, "image": "images/menu.svg" },
  "terminal": {
    "rect": { "left": 330, "top": 172, "right": 22, "bottom": 204 },
    "fontSize": 14,
    "theme": {
      "foreground": "#f3e6cc",
      "background": "#1d140f",
      "cursor": "#e8a85a",
      "cursorAccent": "#1d140f",
      "selectionBackground": "#4a3424",
      "black": "#1d140f",
      "red": "#e77d68",
      "green": "#b5c98a",
      "yellow": "#e8c36a",
      "blue": "#8eb0d8",
      "magenta": "#d49ab8",
      "cyan": "#8cc8bc",
      "white": "#f3e6cc",
      "brightBlack": "#7d6654",
      "brightRed": "#ffa898",
      "brightGreen": "#d4e6aa",
      "brightYellow": "#ffe09a",
      "brightBlue": "#b6cff0",
      "brightMagenta": "#f0bcd8",
      "brightCyan": "#b4e6dc",
      "brightWhite": "#fff8ea"
    }
  },
  "fonts": [
    { "family": "Amatic SC", "file": "fonts/AmaticSC/AmaticSC-Bold.ttf", "weight": "bold" },
    { "family": "Shrikhand", "file": "fonts/Shrikhand/Shrikhand-Regular.ttf" },
    { "family": "Cutive Mono", "file": "fonts/CutiveMono/CutiveMono-Regular.ttf" }
  ],
  "stylesheet": "skin.css",
  "panels": [
    { "class": "room", "rect": { "left": 0, "right": 0, "top": 0, "bottom": 0 } },
    { "class": "frame", "rect": { "left": 14, "top": 18, "right": 350, "height": 144 } },
    { "class": "slate", "rect": { "left": 24, "top": 28, "right": 360, "height": 124 } },
    { "class": "board-title", "rect": { "left": 76, "top": 30, "width": 110, "height": 34 } },
    { "class": "doodles", "rect": { "left": 196, "top": 33, "width": 300, "height": 28 } },
    { "class": "doodle", "rect": { "right": 368, "top": 32, "width": 92, "height": 116 } },
    { "class": "cork", "rect": { "right": 104, "top": 20, "width": 228, "height": 140 } },
    { "class": "shelf", "rect": { "right": 10, "top": 152, "width": 92, "height": 14 } },
    { "class": "cabinet", "rect": { "left": 14, "top": 170, "width": 300, "bottom": 12 } },
    { "class": "deck", "rect": { "left": 22, "top": 178, "width": 284, "height": 200 } },
    { "class": "amp", "rect": { "left": 22, "top": 386, "width": 284, "height": 168 } },
    { "class": "lps", "rect": { "left": 22, "top": 562, "width": 284, "bottom": 20 } },
    { "class": "sash", "rect": { "left": 322, "top": 164, "right": 14, "bottom": 196 } },
    { "class": "tabletop", "rect": { "left": 322, "right": 14, "bottom": 60, "height": 54 } },
    { "class": "cloth", "rect": { "left": 322, "right": 14, "bottom": 10, "height": 52 } },
    { "class": "bottle", "rect": { "left": 570, "bottom": 78, "width": 44, "height": 112 } },
    { "class": "plant", "rect": { "left": 622, "bottom": 70, "width": 86, "height": 120 } },
    { "class": "typewriter", "rect": { "right": 222, "bottom": 70, "width": 168, "height": 96 } }
  ],
  "widgets": [
    { "id": "lights", "type": "led", "bind": "event.tool", "pulse": true, "pulseMs": 450, "label": "tool call",
      "class": "lights", "rect": { "left": 0, "right": 0, "top": 0, "height": 30 } },
    { "id": "ctx-line", "type": "readout", "bind": "context.used_pct", "format": "pct", "label": "context",
      "class": "line", "rect": { "left": 44, "top": 64, "width": 280, "height": 26 } },
    { "id": "cost", "type": "readout", "bind": "cost.usd", "format": "usd", "label": "cost",
      "class": "line", "rect": { "left": 44, "top": 90, "width": 280, "height": 26 } },
    { "id": "tools", "type": "readout", "bind": "tools.total", "label": "tool calls",
      "class": "line", "rect": { "left": 44, "top": 116, "width": 280, "height": 26 } },
    { "id": "tin", "type": "readout", "bind": "tokens.in", "format": "tokens", "label": "tokens in",
      "class": "line", "rect": { "left": 364, "top": 64, "width": 264, "height": 26 } },
    { "id": "tout", "type": "readout", "bind": "tokens.out", "format": "tokens", "label": "tokens out",
      "class": "line", "rect": { "left": 364, "top": 90, "width": 264, "height": 26 } },
    { "id": "model", "type": "readout", "bind": "model.name", "format": "text", "label": "on stage",
      "class": "line", "rect": { "left": 364, "top": 116, "width": 264, "height": 26 } },
    { "id": "open", "type": "readout", "bind": "session.clock_s", "format": "duration", "label": "open for",
      "class": "handbill", "rect": { "right": 223, "top": 104, "width": 90, "height": 40 } },
    { "id": "brewing", "type": "led", "bind": "state.busy", "on": 1, "label": "brewing",
      "class": "lava", "rect": { "right": 22, "top": 4, "width": 68, "height": 150 } },
    { "id": "spin", "type": "led", "bind": "pty.out_bps", "on": 20, "label": "playing",
      "class": "spin", "rect": { "left": 34, "top": 192, "width": 172, "height": 172 } },
    { "id": "context", "type": "gauge", "bind": "context.used_pct", "format": "pct", "label": "context", "max": 100,
      "thickness": 6, "startAngle": -160, "endAngle": 160, "marks": [{ "bind": "context.compact_at_pct" }],
      "class": "platter", "rect": { "left": 34, "top": 192, "width": 172, "height": 172 } },
    { "id": "vu", "type": "needle", "bind": "tokens.out_rate", "label": "tokens / s", "max": 150,
      "face": "images/vu.png", "class": "vu", "rect": { "left": 38, "top": 398, "width": 160, "height": 120 } },
    { "id": "cpu", "type": "knob", "bind": "proc.cpu_pct", "max": 100, "image": "images/knob.png", "label": "cpu",
      "format": "pct", "damping": 1, "class": "cpu", "rect": { "left": 214, "top": 400, "width": 84, "height": 116 } },
    { "id": "cache", "type": "bar", "bind": "cache.hit_ratio", "label": "cache", "max": 1, "orientation": "vertical",
      "class": "press tape", "rect": { "left": 346, "bottom": 74, "width": 70, "height": 118 } },
    { "id": "lim5", "type": "bar", "bind": "limits.five_hour_pct", "resets": "limits.five_hour_resets_at", "label": "5 hours", "max": 100, "orientation": "vertical",
      "class": "jar tape", "rect": { "left": 434, "bottom": 80, "width": 56, "height": 100 } },
    { "id": "lim7", "type": "bar", "bind": "limits.seven_day_pct", "resets": "limits.seven_day_resets_at", "fallback": { "bind": "limits.spend_pct", "label": "spend", "resets": "limits.spend_resets_at" }, "label": "7 days", "max": 100, "orientation": "vertical",
      "class": "jar tape", "rect": { "left": 498, "bottom": 76, "width": 56, "height": 100 } },
    { "id": "helpers", "type": "sprite", "bind": "agents.active", "min": 0, "max": 4, "sheet": "images/mugs.png",
      "frames": 5, "frameWidth": 372, "frameHeight": 168, "label": "subagents",
      "class": "mugs tape", "rect": { "right": 24, "bottom": 70, "width": 186, "height": 104 } },
    { "id": "todo", "type": "list", "bind": "checklist.items", "rows": 3,
      "class": "chalk-list", "rect": { "left": 44, "top": 62, "width": 584, "height": 84 },
      "toggle": { "rect": { "left": 504, "top": 34, "width": 128, "height": 26 }, "labels": ["tasks", "menu"], "class": "chalk-tabs" } }
  ],
  "sounds": [
    { "file": "sounds/murmur.ogg", "mode": "loop", "volume": 0.5 },
    { "file": "sounds/mug-1.ogg", "mode": "random", "volume": 0.3, "interval": [25, 90] },
    { "file": "sounds/mug-2.ogg", "mode": "random", "volume": 0.3, "interval": [30, 120] },
    { "file": "sounds/typewriter.ogg", "mode": "random", "volume": 0.3, "interval": [90, 240] },
    { "file": "sounds/pour.ogg", "mode": "random", "volume": 0.3, "interval": [120, 300] },
    { "file": "sounds/beads.ogg", "mode": "random", "volume": 0.25, "interval": [120, 360] },
    { "file": "sounds/grinder.ogg", "mode": "random", "volume": 0.25, "interval": [150, 360] },
    { "file": "sounds/bongos.ogg", "mode": "random", "volume": 0.25, "interval": [180, 420] },
    { "file": "sounds/needle.ogg", "mode": "random", "volume": 0.35, "interval": [200, 480] },
    { "file": "sounds/snaps.ogg", "mode": "random", "volume": 0.3, "interval": [240, 600] },
    { "file": "sounds/guitar.ogg", "mode": "random", "volume": 0.25, "interval": [240, 600] }
  ]
}
