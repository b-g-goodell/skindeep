{
  "name": "library",
  "version": "1.0.0",
  "author": "claude-skins",
  "license": "project-original",
  "description": "A quiet reading room: shelves of books, chalk meters on a chalkboard, marker bars on a whiteboard, readouts on card catalog labels and a reading lamp that lights while the agent works.",
  "window": { "width": 1240, "height": 820, "minWidth": 1100, "minHeight": 680 },
  "menu": { "rect": { "left": 12, "top": 12, "width": 36, "height": 28 }, "image": "images/menu.svg" },
  "terminal": {
    "rect": { "left": 324, "top": 146, "right": 18, "bottom": 192 },
    "fontSize": 14,
    "theme": {
      "foreground": "#ebe7da",
      "background": "#1f2a24",
      "cursor": "#f6dd7a",
      "cursorAccent": "#1f2a24",
      "selectionBackground": "#3e5246",
      "black": "#1f2a24",
      "red": "#f08a7e",
      "green": "#a8d8a0",
      "yellow": "#f6dd7a",
      "blue": "#8fb4e8",
      "magenta": "#d8a8d8",
      "cyan": "#8fd8d0",
      "white": "#ebe7da",
      "brightBlack": "#6f8276",
      "brightRed": "#ffb0a6",
      "brightGreen": "#c8f0c0",
      "brightYellow": "#fff0a8",
      "brightBlue": "#b8d0f8",
      "brightMagenta": "#f0c8f0",
      "brightCyan": "#b8f0e8",
      "brightWhite": "#ffffff"
    }
  },
  "fonts": [
    { "family": "Permanent Marker", "file": "fonts/PermanentMarker/PermanentMarker-Regular.ttf" },
    { "family": "Special Elite", "file": "fonts/SpecialElite/SpecialElite-Regular.ttf" }
  ],
  "stylesheet": "skin.css",
  "panels": [
    { "class": "room", "rect": { "left": 0, "right": 0, "top": 0, "bottom": 0 } },
    { "class": "shelf", "rect": { "left": 0, "right": 132, "top": 0, "height": 128 } },
    { "class": "shelf-end", "rect": { "right": 120, "top": 0, "width": 14, "height": 132 } },
    { "class": "plaque", "rect": { "right": 14, "top": 14, "width": 96, "height": 108 } },
    { "class": "frame", "rect": { "left": 12, "top": 140, "width": 296, "bottom": 12 } },
    { "class": "board", "rect": { "left": 24, "top": 152, "width": 272, "bottom": 24 } },
    { "class": "frame", "rect": { "left": 316, "top": 138, "right": 10, "bottom": 184 } },
    { "class": "whiteboard", "rect": { "left": 316, "bottom": 12, "width": 336, "height": 162 } },
    { "class": "catalog", "rect": { "right": 10, "bottom": 12, "width": 432, "height": 162 } },
    { "class": "drawer", "rect": { "right": 302, "bottom": 92, "width": 134, "height": 76 } },
    { "class": "drawer", "rect": { "right": 160, "bottom": 92, "width": 134, "height": 76 } },
    { "class": "drawer", "rect": { "right": 18, "bottom": 92, "width": 134, "height": 76 } },
    { "class": "drawer", "rect": { "right": 302, "bottom": 18, "width": 134, "height": 68 } },
    { "class": "drawer", "rect": { "right": 160, "bottom": 18, "width": 134, "height": 68 } },
    { "class": "drawer", "rect": { "right": 18, "bottom": 18, "width": 134, "height": 68 } },
    { "class": "pull", "rect": { "right": 361, "bottom": 97, "width": 16, "height": 10 } },
    { "class": "pull", "rect": { "right": 219, "bottom": 97, "width": 16, "height": 10 } },
    { "class": "pull", "rect": { "right": 77, "bottom": 97, "width": 16, "height": 10 } },
    { "class": "pull", "rect": { "right": 361, "bottom": 23, "width": 16, "height": 10 } },
    { "class": "pull", "rect": { "right": 219, "bottom": 23, "width": 16, "height": 10 } },
    { "class": "pull", "rect": { "right": 77, "bottom": 23, "width": 16, "height": 10 } }
  ],
  "widgets": [
    { "id": "ctx", "type": "gauge", "bind": "context.used_pct", "format": "pct", "label": "context", "max": 100,
      "ticks": 10, "thickness": 9, "startAngle": -130, "endAngle": 130, "marks": [{ "bind": "context.compact_at_pct" }],
      "class": "chalk", "rect": { "left": 40, "top": 160, "width": 240, "height": 232 } },
    { "id": "ctx-tokens", "type": "readout", "bind": "context.used_tokens", "format": "tokens", "label": "in context",
      "class": "chalk-note", "rect": { "left": 44, "top": 398, "width": 112, "height": 50 } },
    { "id": "ctx-compact", "type": "readout", "bind": "context.compact_threshold", "format": "tokens", "label": "compact at",
      "class": "chalk-note", "rect": { "left": 166, "top": 398, "width": 112, "height": 50 } },
    { "id": "rate", "type": "needle", "bind": "tokens.out_rate", "label": "tokens / s", "max": 150, "ticks": 6,
      "class": "chalk", "rect": { "left": 56, "top": 456, "width": 208, "height": 118 } },
    { "id": "tool", "type": "led", "bind": "event.tool", "pulse": true, "pulseMs": 350, "label": "tool call",
      "class": "chalk-lamp", "rect": { "left": 44, "top": 586, "width": 112, "height": 26 } },
    { "id": "agent", "type": "led", "bind": "agents.active", "on": 1, "blink": 500, "label": "subagent",
      "class": "chalk-lamp", "rect": { "left": 166, "top": 586, "width": 112, "height": 26 } },
    { "id": "reading", "type": "sprite", "bind": "state.busy", "min": 0, "max": 1, "sheet": "images/lamp.png",
      "frames": 2, "frameWidth": 140, "frameHeight": 120, "label": "working",
      "class": "lamp", "rect": { "right": 150, "top": 0, "width": 140, "height": 132 } },
    { "id": "pace", "type": "knob", "bind": "tools.rate", "max": 30, "image": "images/knob.png", "label": "pace",
      "format": "fixed:1", "class": "brass", "rect": { "right": 22, "top": 22, "width": 80, "height": 96 } },
    { "id": "cache", "type": "bar", "bind": "cache.hit_ratio", "label": "cache hits", "max": 1, "segments": 14, "gap": 3,
      "class": "marker blue", "rect": { "left": 336, "bottom": 118, "width": 296, "height": 40 } },
    { "id": "lims", "type": "limits", "bind": "limits.items", "meter": "bar", "suffix": " limit", "itemClass": "marker", "max": 100, "segments": 14, "gap": 3,
      "class": "lims", "rect": { "left": 336, "bottom": 26, "width": 296, "height": 86 } },
    { "id": "cost", "type": "readout", "bind": "cost.usd", "format": "usd", "label": "cost",
      "class": "card", "rect": { "right": 313, "bottom": 112, "width": 112, "height": 50 } },
    { "id": "tools", "type": "readout", "bind": "tools.total", "label": "tool calls",
      "class": "card", "rect": { "right": 171, "bottom": 112, "width": 112, "height": 50 } },
    { "id": "clock", "type": "readout", "bind": "session.clock_s", "format": "duration", "label": "on loan",
      "class": "card", "rect": { "right": 29, "bottom": 112, "width": 112, "height": 50 } },
    { "id": "tin", "type": "readout", "bind": "tokens.in", "format": "tokens", "label": "tokens in",
      "class": "card", "rect": { "right": 313, "bottom": 34, "width": 112, "height": 46 } },
    { "id": "tout", "type": "readout", "bind": "tokens.out", "format": "tokens", "label": "tokens out",
      "class": "card", "rect": { "right": 171, "bottom": 34, "width": 112, "height": 46 } },
    { "id": "model", "type": "readout", "bind": "model.name", "format": "text", "label": "model",
      "class": "card", "rect": { "right": 29, "bottom": 34, "width": 112, "height": 46 } }
  ]
}
