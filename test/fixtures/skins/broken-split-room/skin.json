{
 "name": "broken-split-room",
 "window": { "width": 1000, "height": 700, "minWidth": 800, "minHeight": 500 },
 "menu": { "rect": { "left": 8, "top": 8, "width": 24, "height": 24 }, "image": "menu.svg" },
 "terminal": {
  "rect": { "left": 10, "top": 60, "right": 200, "bottom": 10 },
  "theme": { "foreground": "#e0e0e0", "background": "#000000" }
 },
 "splits": [
  { "id": "side", "edge": "right", "min": 150, "max": 760 }
 ],
 "widgets": [
  { "id": "fixed", "type": "readout", "bind": "tools.total", "rect": { "right": 20, "top": 100, "width": 160, "height": 30 } },
  { "id": "wide", "type": "readout", "bind": "tools.total", "follow": { "width": "side" }, "rect": { "right": 20, "top": 140, "width": 160, "height": 30 } },
  { "id": "thin", "type": "readout", "bind": "tools.total", "follow": { "width": "side" }, "rect": { "right": 20, "top": 180, "width": 30, "height": 30 } },
  { "id": "under", "type": "readout", "bind": "tools.total", "rect": { "left": 300, "top": 140, "width": 50, "height": 30 } }
 ]
}
